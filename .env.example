# PlanWise AI Configuration
# Copy this file to .env and adjust values as needed.

# ── LLM (hosted, free-tier APIs) ─────────────────────────────────
# auto = use every provider below that has a key (in this order), then fall
# back to the keyless endpoint. Or force one: groq | gemini | openrouter |
# pollinations | custom | ollama
LLM_PROVIDER=auto

# Groq - free key in ~1 minute at https://console.groq.com/keys (recommended: very fast)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Google Gemini - free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# OpenRouter - free key at https://openrouter.ai/keys (use a ":free" model)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemma-4-31b-it:free

# Keyless fallback (no signup). Works out of the box but is limited to about
# one AI reply every 45 seconds and is slow - add a key above for real use.
POLLINATIONS_BASE_URL=https://text.pollinations.ai/openai
POLLINATIONS_MODEL=openai

# Optional: any other OpenAI-compatible endpoint
CUSTOM_LLM_BASE_URL=
CUSTOM_LLM_API_KEY=
CUSTOM_LLM_MODEL=

# Optional: local Ollama (only used when LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b-instruct

LLM_TIMEOUT=60
LLM_MAX_RETRIES=2

# ── Live location data (OpenStreetMap - free, no key) ────────────
NOMINATIM_URL=https://nominatim.openstreetmap.org
GEO_USER_AGENT=PlanWiseAI/2.0 (trip planning assistant)
GEO_TIMEOUT=25

# ── Bundled Cambridge dataset (MultiWOZ) retrieval ───────────────
RETRIEVAL_TOP_K=5
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ── Backend server ───────────────────────────────────────────────
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Streamlit frontend (legacy UI)
BACKEND_URL=http://localhost:8000

# Logging
LOG_LEVEL=INFO

# Agent
MAX_REPLAN_ATTEMPTS=2
MAX_TRIP_DAYS=14
